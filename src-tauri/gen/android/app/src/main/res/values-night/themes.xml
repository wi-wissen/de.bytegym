<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The app draws edge-to-edge (MainActivity.kt), so
         the system bars take their colour from the page; the window background only
         shows on launch, before the WebView paints, and must match the page. -->
    <style name="Theme.bytegym" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorAccent">@color/app_primary</item>
        <!-- Android 12+ launch splash: app icon on the app background. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/app_background</item>
    </style>
</resources>
